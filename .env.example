# Copy this file as .env and fill in your real values
# The .env file is listed in .gitignore and must NEVER be committed to GitHub

# ── TMS credentials (DHL) ────────────────────────────────────────
TMS_USER=your_username_here
TMS_PASSWORD=your_password_here

# ── URLs ─────────────────────────────────────────────────────────
TTURL_login=https://tmstracking.dhl.com/SGLTYT_DHL_PROD/web/login_clientes.asp
TTURL_filter=https://tmstracking.dhl.com/SGLTYT_DHL_PROD/web/reportes-dsp-sac/reporte.asp?...
URL_S4=https://your-sap-instance/FioriLaunchpad.html#Shell-home

# ── Local paths ──────────────────────────────────────────────────
PATH_DRIVER=C:/path/to/chromedriver.exe
PATH_NEWDIR=C:/Users/your_user/Downloads
PATH_ZNETCO=C:/Users/your_user/OneDrive/InputDlvControlFreak/znetco.xlsx
PATH_STATUS=C:/Users/your_user/OneDrive/DeliveryS4/Chile.xlsx
PATH_BBDD=C:/Users/your_user/Desktop/HP_JMVA/Recurrente/BBDD.xlsx
PATH_OUTPUT=C:/Users/your_user/OneDrive/InputDlvControlFreak/cote.xlsx

# ── Email recipients ─────────────────────────────────────────────
EMAIL_LSP=contact@lsp.com
EMAIL_HP=person1@hp.com;person2@hp.com

# ── SQL Server (TarrosCapacity) ──────────────────────────────────
DB_SERVER=your_server_name
DB_DATABASE=your_database_name
PATH_DMR=C:/path/to/dmr.xlsx
PATH_SEGMENTOS=C:/path/to/segmentos.xlsx

# ── AlertaAeropuerto ─────────────────────────────────────────────
DAILYREP_PATH=C:/path/to/daily_report.xlsx
AIRPORTREP_PATH=C:/path/to/airport_arrivals.xlsx
